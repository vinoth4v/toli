# Copy to .env.local and fill in. Never commit .env.local.

# Neon connection string (pooled). Neon dashboard -> Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Only when self-hosting behind a proxy, or serving a production build on
# localhost. Vercel deployments infer the host and do not need this.
# AUTH_TRUST_HOST="true"

# The single operator. Only this address can sign in.
WERFT_USER_EMAIL="you@example.com"

# Generate with: pnpm hash-password '<your password>'
WERFT_PASSWORD_HASH=""

# Only present when the app was scaffolded with --with-s3. Werft mints these:
# a bucket and a bucket-scoped IAM user, so this key can touch this bucket and
# nothing else. Never the AWS admin key.
# S3_BUCKET=""
# AWS_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Model access for the app itself, through the Kompass gateway. Set on every
# scaffolded app, whether or not it uses AI — an app that never calls a model
# simply never reads them. src/kompass.ts is the only thing that should.
KOMPASS_BASE_URL="https://kompass.vinoth4v.workers.dev"
KOMPASS_TOKEN=""

# The public origin, used to build tracking links that go out over WhatsApp.
# Without it, links are built against the production URL.
# NEXT_PUBLIC_APP_URL="https://toli-flame.vercel.app"

# ---------------------------------------------------------------------------
# Integrations. Every one of these is optional: with none of them set the app
# works exactly as it did before, by hand, and each screen says which variable
# is missing rather than pretending. /integrations shows the live inventory.
# ---------------------------------------------------------------------------

# Payments — Razorpay. dashboard.razorpay.com → Settings → API keys; the
# webhook secret is set when you create the webhook pointing at
# /api/webhooks/razorpay. Without these, payments are recorded by hand after
# the money arrives, which still reconciles.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# RAZORPAY_BASE_URL="https://api.razorpay.com/v1"

# Geocoding. Either provider alone works; both is what makes the fallback
# meaningful — Google is better in cities, Mappls on the village and landmark
# addresses a pilgrimage charter actually goes to.
# GOOGLE_MAPS_API_KEY=""
# MAPPLS_REST_KEY=""

# Routing — self-hosted OSRM on the India OSM extract. This is the one that
# saves real money: every quote needs a distance, and the same volume on a
# commercial API is ₹4–8 lakh a month against about ₹8,000 for one instance.
# OSRM_BASE_URL="http://osrm.internal:5000"

# Notifications — WhatsApp Business Platform, direct or through a BSP.
# Templates must be registered and approved before they can be sent; the names
# are in src/integrations/whatsapp.ts.
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_API_BASE="https://graph.facebook.com/v21.0"

# Document verification — VAHAN, Sarathi and the GSTN, through an authorised
# aggregator. None of the three is a public API; access is resold to KYC'd
# businesses, so the base URL is whichever aggregator you contract with.
# VEHICLE_VERIFY_BASE_URL=""
# VEHICLE_VERIFY_API_KEY=""
# VEHICLE_VERIFY_PROVIDER=""

# Position ingest needs no credential here: devices are enrolled in the app at
# /integrations and each gets its own bearer token, of which only the SHA-256
# is stored.
